{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "math3-cp3-dev",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "FIREBASE_PROJECT_ID": "math3-dev",
    "ALLOWED_ORIGINS": "https://subsubt.github.io"
  },
  "secrets": {
    "required": ["FIREBASE_SERVICE_ACCOUNT_JSON", "MATH3_SERVER_SECRET"]
  }
}
